# Optional overrides for the offline Gemma 4 E4B-it (llama.cpp) generation layer.
# Place the GGUF at MODEL_PATH before running scripts/ask.py - the app never
# downloads model weights. Embedding weights must also be local
# (EMBEDDING_MODEL_PATH); set HF_HUB_OFFLINE=1 / TRANSFORMERS_OFFLINE=1.
#
# Suggested GGUF (Unsloth Q4_K_M, ~5 GB):
#   hf download unsloth/gemma-4-E4B-it-GGUF \
#     --include "gemma-4-E4B-it-Q4_K_M.gguf" \
#     --local-dir models/

# MODEL_NAME=Gemma-4-E4B-it
# MODEL_PATH=models/gemma-4-E4B-it-Q4_K_M.gguf
# EMBEDDING_MODEL_PATH=models/embeddings/KEmbed-naija-v3
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# CONTEXT_LENGTH=4096
# THREADS=  # default: max(2, cpu_count - 1)
# MAX_TOKENS=512
# TEMPERATURE=0.1
# MAX_CONTEXT_TOKENS=3000
# MIN_RETRIEVAL_SCORE=0.35
# PROMPTS_DIR=app/prompts
# Flash Attention (default true): avoids Gemma V-cache pad-to-1024 when FA is off.
# FLASH_ATTN=true
# Full-size SWA cache (default false): false uses window-sized SWA KV for Gemma ISWA.
# SWA_FULL=false
# Profiled llama.cpp memory knobs (Gemma-4-E4B-it):
# FLASH_ATTN=true
# SWA_FULL=false
